<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tunelith.Maui.ViewModels"
             x:Class="Tunelith.Maui.Views.LibraryPage"
             Style="{StaticResource PageStyle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="0">

        <!-- Ambient Background Glow -->
        <Grid Grid.Row="0" Grid.RowSpan="3">
            <Ellipse Fill="#1500E5FF"
                     WidthRequest="300" HeightRequest="300"
                     HorizontalOptions="Center"
                     VerticalOptions="Start"
                     Margin="0,-80,0,0"/>
        </Grid>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,24,24,0" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Your Library"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"/>
                <Label Text="READY FOR SCAN"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       TextColor="{StaticResource TextSecondary}"
                       Margin="0,2,0,0"/>
            </VerticalStackLayout>

            <!-- Profile photo / Logout button -->
            <Frame Grid.Column="1"
                   BackgroundColor="{StaticResource SurfaceColor}"
                   BorderColor="{StaticResource CardBorder}"
                   CornerRadius="20"
                   Padding="0"
                   HeightRequest="40" WidthRequest="40"
                   HasShadow="False"
                   IsClippedToBounds="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LogoutCommand}"/>
                </Frame.GestureRecognizers>
                <Grid>
                    <!-- Fallback: emoji when no profile photo -->
                    <Label Text="👤"
                           FontSize="16"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    <!-- Overlay: actual photo when available -->
                    <Image Source="{Binding ProfileImageUrl}"
                           Aspect="AspectFill"
                           HeightRequest="40" WidthRequest="40"
                           Opacity="{Binding ProfileImageUrl, Converter={StaticResource StringToImageOpacityConverter}}"/>
                </Grid>
            </Frame>
        </Grid>

        <!-- Stats Row -->
        <Grid Grid.Row="1" ColumnDefinitions="*,12,*" Padding="24,16,24,0">
            <!-- Tracks -->
            <Frame Grid.Column="0"
                   Style="{StaticResource StatCard}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="TRACKS"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="1.2"
                           TextColor="{StaticResource TextSecondary}"/>
                    <Label Text="{Binding LikedSongsCount}"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}">
                        <Label.Shadow>
                            <Shadow Brush="{StaticResource PrimaryGold}"
                                    Offset="0,0" Radius="12" Opacity="0.4"/>
                        </Label.Shadow>
                    </Label>
                </VerticalStackLayout>
            </Frame>

            <!-- Playlists -->
            <Frame Grid.Column="2"
                   Style="{StaticResource StatCard}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="PLAYLISTS"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="1.2"
                           TextColor="{StaticResource TextSecondary}"/>
                    <Label Text="{Binding PlaylistsCount}"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}">
                        <Label.Shadow>
                            <Shadow Brush="{StaticResource SecondaryCyan}"
                                    Offset="0,0" Radius="12" Opacity="0.4"/>
                        </Label.Shadow>
                    </Label>
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- Scan Reminder Banner -->
        <Frame Grid.Row="2"
               BackgroundColor="#33FFD700"
               CornerRadius="0"
               Padding="24,12"
               HasShadow="False"
               BorderColor="Transparent"
               IsVisible="{Binding ShowScanReminder}">
            <Label Text="{Binding ScanReminderMessage}"
                   FontSize="13"
                   TextColor="{StaticResource PrimaryGold}"
                   HorizontalTextAlignment="Center"/>
        </Frame>

        <!-- Health Score + Duplicates (hidden until analysis exists) -->
        <VerticalStackLayout Grid.Row="3"
                             Margin="24,12,24,0"
                             IsVisible="{Binding HasAnalysis}">
            <Grid ColumnDefinitions="*,12,*">
                <!-- Health Score -->
                <Frame Grid.Column="0"
                       Style="{StaticResource StatCard}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                        <Label Text="HEALTH SCORE"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.2"
                               TextColor="{StaticResource TextSecondary}"/>
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                            <Label Text="{Binding HealthScore}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryGold}">
                                <Label.Shadow>
                                    <Shadow Brush="{StaticResource PrimaryGold}"
                                            Offset="0,0" Radius="10" Opacity="0.5"/>
                                </Label.Shadow>
                            </Label>
                            <Label Grid.Column="1"
                                   Text="{Binding HealthGrade}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="End"
                                   Margin="0,0,0,4"/>
                        </Grid>
                    </Grid>
                </Frame>

                <!-- Potential Duplicates -->
                <Frame Grid.Column="2"
                       Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="DUPLICATES"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.2"
                               TextColor="{StaticResource TextSecondary}"/>
                        <Label Text="{Binding EstimatedDuplicates}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource SecondaryCyan}">
                            <Label.Shadow>
                                <Shadow Brush="{StaticResource SecondaryCyan}"
                                        Offset="0,0" Radius="10" Opacity="0.5"/>
                            </Label.Shadow>
                        </Label>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- View History Button -->
            <Button Text="View Scan History"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ViewHistoryCommand}"
                    Margin="0,8,0,0"/>
        </VerticalStackLayout>

        <!-- Studio Intelligence Card -->
        <Frame Grid.Row="4"
               Style="{StaticResource GlassCard}"
               Margin="24,16,24,0"
               VerticalOptions="Center">
            <VerticalStackLayout Spacing="12">
                <!-- Icon -->
                <Grid WidthRequest="60" HeightRequest="60"
                      HorizontalOptions="Center">
                    <Frame BackgroundColor="{StaticResource SurfaceLight}"
                           BorderColor="{StaticResource CardBorder}"
                           CornerRadius="14"
                           Padding="0"
                           HasShadow="False">
                        <Label Text="✦"
                               FontSize="24"
                               TextColor="{StaticResource PrimaryGold}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>
                </Grid>

                <Label Text="Studio Intelligence"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Ready to analyze your library and&#x0a;suggest duplicate cleanup and&#x0a;genre-based organization."
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>

                <Button Text="Scan My Library"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ScanLibraryCommand}"
                        Margin="0,8,0,0"/>

                <Label Text="APPROX. 45 SECONDS"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.2"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>
        </Frame>

        <!-- Loading & Status -->
        <VerticalStackLayout Grid.Row="5"
                             Padding="24,0,24,24"
                             Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Style="{StaticResource GoldActivityIndicator}"/>
            <Label Text="{Binding StatusMessage}"
                   Style="{StaticResource BodySecondaryLabel}"
                   FontSize="12"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
