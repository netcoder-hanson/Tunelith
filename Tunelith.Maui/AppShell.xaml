<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Tunelith.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Tunelith.Maui.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Tunelith"
    Shell.BackgroundColor="{StaticResource BackgroundColor}"
    Shell.ForegroundColor="{StaticResource PrimaryGold}"
    Shell.TitleColor="{StaticResource TextPrimary}"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Library"
        ContentTemplate="{DataTemplate views:LibraryPage}"
        Route="LibraryPage" />

    <ShellContent
        Title="Analyzing"
        ContentTemplate="{DataTemplate views:AnalyzingStudioPage}"
        Route="AnalyzingStudioPage" />

    <ShellContent
        Title="Report"
        ContentTemplate="{DataTemplate views:ChangeReportPage}"
        Route="ChangeReportPage" />

    <ShellContent
        Title="Duplicates"
        ContentTemplate="{DataTemplate views:DuplicateCleanupPage}"
        Route="DuplicateCleanupPage" />

    <ShellContent
        Title="Mastered"
        ContentTemplate="{DataTemplate views:LibraryMasteredPage}"
        Route="LibraryMasteredPage" />

    <ShellContent
        Title="History"
        ContentTemplate="{DataTemplate views:ScanHistoryPage}"
        Route="ScanHistoryPage" />

</Shell>
