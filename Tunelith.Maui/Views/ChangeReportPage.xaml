<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tunelith.Maui.ViewModels"
             x:Class="Tunelith.Maui.Views.ChangeReportPage"
             Style="{StaticResource PageStyle}">

    <ContentPage.BindingContext>
        <vm:ChangeReportViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16">

        <!-- Header -->
        <Label Grid.Row="0"
               Text="Change Report"
               Style="{StaticResource TitleLabel}"
               Margin="0,0,0,4"/>
        <Label Grid.Row="0"
               Text="Review before applying"
               Style="{StaticResource SubtitleLabel}"
               Margin="0,38,0,0"/>

        <!-- Summary Stats -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,12,0,16">
            <Frame Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Report.PlaylistsToCreate.Count}"
                           Style="{StaticResource TitleLabel}" FontSize="20" HorizontalTextAlignment="Center"/>
                    <Label Text="Playlists" Style="{StaticResource SubtitleLabel}" FontSize="11" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Frame>
            <Frame Grid.Column="1" Style="{StaticResource GlassPanel}" Padding="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Report.TotalTracksResorted}"
                           Style="{StaticResource TitleLabel}" FontSize="20" HorizontalTextAlignment="Center"/>
                    <Label Text="Tracks" Style="{StaticResource SubtitleLabel}" FontSize="11" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Frame>
            <Frame Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Report.DuplicatesToRemove.Count}"
                           Style="{StaticResource TitleLabel}" FontSize="20" HorizontalTextAlignment="Center"/>
                    <Label Text="Duplicates" Style="{StaticResource SubtitleLabel}" FontSize="11" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- Details -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="12">

                <!-- Playlists to Create -->
                <Label Text="Playlists to Create"
                       Style="{StaticResource AccentLabel}"
                       IsVisible="{Binding Report.PlaylistsToCreate.Count, Converter={StaticResource IsGreaterThanZeroConverter}}"/>

                <CollectionView ItemsSource="{Binding Report.PlaylistsToCreate}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:Object">
                            <Frame Style="{StaticResource GlassPanel}" Padding="14" Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource BodyLabel}" FontAttributes="Bold"/>
                                        <Label Text="{Binding TrackIds.Count, StringFormat='{0} tracks to add'}"
                                               Style="{StaticResource SubtitleLabel}" FontSize="11"/>
                                    </VerticalStackLayout>
                                    <Frame Grid.Column="1"
                                           BackgroundColor="{StaticResource SuccessGreen}"
                                           CornerRadius="8"
                                           Padding="8,4"
                                           VerticalOptions="Center">
                                        <Label Text="NEW" Color="{StaticResource BackgroundColor}" FontSize="10" FontAttributes="Bold"/>
                                    </Frame>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Duplicates -->
                <Label Text="Duplicates to Remove"
                       Style="{StaticResource AccentLabel}"
                       Margin="0,8,0,0"
                       IsVisible="{Binding Report.DuplicatesToRemove.Count, Converter={StaticResource IsGreaterThanZeroConverter}}"/>

                <CollectionView ItemsSource="{Binding Report.DuplicatesToRemove}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:Object">
                            <Frame Style="{StaticResource GlassPanel}" Padding="14" Margin="0,4">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Tracks[0].DisplayName}" Style="{StaticResource BodyLabel}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Tracks[1].DisplayName}" Style="{StaticResource BodyLabel}"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Actions -->
        <VerticalStackLayout Grid.Row="3" Spacing="8" Margin="0,12,0,0">
            <ActivityIndicator IsRunning="{Binding IsApplying}"
                               IsVisible="{Binding IsApplying}"
                               Style="{StaticResource GoldActivityIndicator}"/>
            <Label Text="{Binding StatusMessage}"
                   Style="{StaticResource BodyLabel}"
                   FontSize="12"
                   HorizontalTextAlignment="Center"/>
            <Button Text="Apply Changes to Spotify"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ApplyChangesCommand}"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
