<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tunelith.Maui.ViewModels"
             x:Class="Tunelith.Maui.Views.ChangeReportPage"
             Style="{StaticResource PageStyle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="0">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,24,24,0">
            <VerticalStackLayout>
                <Label Text="Studio Report"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"/>
                <Label Text="OPTIMIZATION DRAFT"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       TextColor="{StaticResource TextSecondary}"
                       Margin="0,2,0,0"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Analysis Complete Card -->
        <Frame Grid.Row="1"
               Style="{StaticResource GlassCard}"
               Padding="24,24,24,20"
               Margin="24,16,24,0">
            <VerticalStackLayout Spacing="8">
                <!-- Icon -->
                <Grid WidthRequest="48" HeightRequest="48"
                      HorizontalOptions="Center">
                    <Frame BackgroundColor="{StaticResource SecondaryCyan}"
                           CornerRadius="12"
                           Padding="0"
                           HasShadow="False"
                           BorderColor="Transparent">
                        <Label Text="📋"
                               FontSize="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>
                </Grid>

                <Label Text="Analysis Complete"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalTextAlignment="Center"/>

                <Label Text="We found several ways to optimize your library."
                       FontSize="13"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,8"/>

                <!-- Summary stats row -->
                <Grid ColumnDefinitions="*,*">
                    <Frame Grid.Column="0"
                           BackgroundColor="{StaticResource SurfaceLight}"
                           CornerRadius="10"
                           Padding="14,12"
                           HasShadow="False"
                           BorderColor="Transparent">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="DUPLICATES"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="{Binding Report.DuplicatesToRemove.Count, StringFormat='{0} Tracks'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryCyan}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1"
                           BackgroundColor="{StaticResource SurfaceLight}"
                           CornerRadius="10"
                           Padding="14,12"
                           HasShadow="False"
                           BorderColor="Transparent">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="NEW PLAYLISTS"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="{Binding Report.PlaylistsToCreate.Count, StringFormat='{0} Created'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryCyan}"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- Proposed Changes Header -->
        <Label Grid.Row="2"
               Text="PROPOSED CHANGES"
               FontSize="11"
               FontAttributes="Bold"
               CharacterSpacing="1.5"
               TextColor="{StaticResource TextSecondary}"
               Padding="24,20,24,8"/>

        <!-- Proposed Changes List -->
        <ScrollView Grid.Row="3">
            <VerticalStackLayout Spacing="8" Padding="24,0,24,0">

                <!-- Duplicate Cleanup -->
                <Frame Style="{StaticResource GlassCard}" Padding="16,14">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Frame Grid.Column="0"
                               BackgroundColor="{StaticResource SurfaceLight}"
                               CornerRadius="10"
                               Padding="8"
                               HasShadow="False"
                               BorderColor="Transparent"
                               HeightRequest="40" WidthRequest="40">
                            <Label Text="🔄"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Margin="12,0,0,0">
                            <Label Text="Duplicate Cleanup"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Remove exact &amp; near-matches"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="{Binding Report.DuplicatesToRemove.Count}"
                               FontSize="15"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center"
                               Margin="8,0"/>

                        <Label Grid.Column="3"
                               Text="›"
                               FontSize="20"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- Category items from Report -->
                <CollectionView ItemsSource="{Binding Report.PlaylistsToCreate}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource GlassCard}" Padding="16,14" Margin="0">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="{StaticResource SurfaceLight}"
                                           CornerRadius="10"
                                           Padding="8"
                                           HasShadow="False"
                                           BorderColor="Transparent"
                                           HeightRequest="40" WidthRequest="40">
                                        <Label Text="🎵"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>

                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Margin="12,0,0,0">
                                        <Label Text="{Binding Name}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"/>
                                        <Label Text="New smart playlist proposal"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="{Binding TrackIds.Count}"
                                           FontSize="15"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center"
                                           Margin="8,0"/>

                                    <Label Grid.Column="3"
                                           Text="›"
                                           FontSize="20"
                                           TextColor="{StaticResource TextSecondary}"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Buttons -->
        <VerticalStackLayout Grid.Row="4"
                             Spacing="10"
                             Padding="24,12,24,24">
            <ActivityIndicator IsRunning="{Binding IsApplying}"
                               IsVisible="{Binding IsApplying}"
                               Style="{StaticResource GoldActivityIndicator}"/>
            <Label Text="{Binding StatusMessage}"
                   Style="{StaticResource BodySecondaryLabel}"
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNullConverter}}"/>
            <Button Text="Approve All Changes"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ApplyChangesCommand}"/>
            <Button Text="Review Selectively"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ReviewSelectiveCommand}"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
