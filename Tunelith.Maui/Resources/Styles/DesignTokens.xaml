<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Color Tokens - Exact from design -->
    <Color x:Key="BackgroundColor">#0D0D0D</Color>
    <Color x:Key="SurfaceColor">#16162A</Color>
    <Color x:Key="SurfaceLight">#1E1E3A</Color>
    <Color x:Key="PrimaryGold">#FFD700</Color>
    <Color x:Key="SecondaryCyan">#00E5FF</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#888899</Color>
    <Color x:Key="TextMuted">#555566</Color>
    <Color x:Key="GlassBorderColor">#33FFD700</Color>
    <Color x:Key="GlassBackgroundColor">#1A16162A</Color>
    <Color x:Key="CardBorder">#2A2A44</Color>
    <Color x:Key="DangerRed">#FF4444</Color>
    <Color x:Key="SuccessGreen">#44FF88</Color>
    <Color x:Key="GoldGlow">#33FFD700</Color>
    <Color x:Key="CyanGlow">#3300E5FF</Color>

    <!-- Page Background -->
    <Style x:Key="PageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundColor}"/>
    </Style>

    <!-- Primary Button (Gold) - full width, rounded -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryGold}"/>
        <Setter Property="TextColor" Value="{StaticResource BackgroundColor}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="HeightRequest" Value="54"/>
        <Setter Property="MinimumHeightRequest" Value="54"/>
        <Setter Property="BorderColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
    </Style>

    <!-- Secondary Button (Surface) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="HeightRequest" Value="54"/>
        <Setter Property="MinimumHeightRequest" Value="54"/>
        <Setter Property="BorderColor" Value="{StaticResource CardBorder}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <!-- Glass Card -->
    <Style x:Key="GlassCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="BorderColor" Value="{StaticResource CardBorder}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HasShadow" Value="False"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- Stat Card (Library page) -->
    <Style x:Key="StatCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="BorderColor" Value="{StaticResource CardBorder}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HasShadow" Value="False"/>
        <Setter Property="Padding" Value="20,16"/>
    </Style>

    <!-- Title Label - bold, white -->
    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <!-- Large Title - for page headers -->
    <Style x:Key="LargeTitleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <!-- Subtitle Label -->
    <Style x:Key="SubtitleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Section Header - uppercase, small, muted -->
    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="1.5"/>
    </Style>

    <!-- Body Label -->
    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Body Secondary Label -->
    <Style x:Key="BodySecondaryLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Accent Label (Cyan) -->
    <Style x:Key="AccentLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource SecondaryCyan}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <!-- Gold Label -->
    <Style x:Key="GoldLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource PrimaryGold}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <!-- Badge Label - small uppercase -->
    <Style x:Key="BadgeLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource SecondaryCyan}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="1.2"/>
    </Style>

    <!-- Category Tag -->
    <Style x:Key="CategoryTag" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="BorderColor" Value="{StaticResource CardBorder}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="HasShadow" Value="False"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

    <!-- Activity Indicator -->
    <Style x:Key="GoldActivityIndicator" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource PrimaryGold}"/>
    </Style>

    <!-- Toggle Switch - Gold on -->
    <Style x:Key="GoldSwitch" TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource PrimaryGold}"/>
        <Setter Property="ThumbColor" Value="{StaticResource TextPrimary}"/>
    </Style>

</ResourceDictionary>
