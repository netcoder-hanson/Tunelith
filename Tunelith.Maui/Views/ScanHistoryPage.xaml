<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tunelith.Maui.ViewModels"
             x:Class="Tunelith.Maui.Views.ScanHistoryPage"
             Style="{StaticResource PageStyle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,24,24,0" ColumnDefinitions="Auto,*">
            <Frame Grid.Column="0"
                   BackgroundColor="{StaticResource SurfaceColor}"
                   BorderColor="{StaticResource CardBorder}"
                   CornerRadius="12"
                   Padding="10"
                   HeightRequest="44" WidthRequest="44"
                   VerticalOptions="Center">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoBackCommand}"/>
                </Frame.GestureRecognizers>
                <Label Text="◀"
                       FontSize="14"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Frame>

            <VerticalStackLayout Grid.Column="1"
                                 VerticalOptions="Center"
                                 Margin="12,0,0,0">
                <Label Text="Scan History"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"/>
                <Label Text="{Binding TotalScans, StringFormat='{0} scans recorded'}"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.2"
                       TextColor="{StaticResource TextSecondary}"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Summary Card -->
        <Frame Grid.Row="1"
               Style="{StaticResource GlassCard}"
               Margin="24,16,24,0"
               Padding="20">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="LAST SCORE"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="1.2"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding LastScan.HealthScore, StringFormat='{0}'}"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryGold}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="DUPLICATES"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="1.2"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding LastScan.DuplicatesFound}"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource SecondaryCyan}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Text="CATEGORIES"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="1.2"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding LastScan.CategoriesCreated}"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource SuccessGreen}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Scan History List -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding ScanHistory}"
                        Margin="24,16,24,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource StatCard}"
                           Padding="16"
                           Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}">
                                <Label.Text>
                                    <Binding Path="ScannedAt" StringFormat="{}{0:MMM dd, yyyy HH:mm}"/>
                                </Label.Text>
                            </Label>
                            <Label Grid.Row="0" Grid.Column="1"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryGold}"
                                   VerticalOptions="Center">
                                <Label.Text>
                                    <Binding Path="HealthScore" StringFormat="{}{0}"/>
                                </Label.Text>
                            </Label>

                            <Grid Grid.Row="1" Grid.ColumnSpan="2"
                                  ColumnDefinitions="Auto,8,Auto,16,Auto,8,Auto"
                                  Margin="0,6,0,0">
                                <Label Grid.Column="0"
                                       Text="🎵"
                                       FontSize="12"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="2"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center">
                                    <Label.Text>
                                        <Binding Path="TotalTracks" StringFormat="{}{0} tracks"/>
                                    </Label.Text>
                                </Label>
                                <Label Grid.Column="4"
                                       Text="👥"
                                       FontSize="12"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="6"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center">
                                    <Label.Text>
                                        <Binding Path="DuplicatesFound" StringFormat="{}{0} dupes"/>
                                    </Label.Text>
                                </Label>
                            </Grid>

                            <Label Grid.Row="2" Grid.ColumnSpan="2"
                                   FontSize="11"
                                   TextColor="{StaticResource TextMuted}"
                                   Margin="0,4,0,0">
                                <Label.Text>
                                    <Binding Path="CategoriesCreated" StringFormat="{}{0} categories"/>
                                </Label.Text>
                            </Label>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="2"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
            <Label Text="No scan history yet."
                   FontSize="16"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalTextAlignment="Center"/>
            <Label Text="Run your first library scan to see history here."
                   FontSize="13"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
