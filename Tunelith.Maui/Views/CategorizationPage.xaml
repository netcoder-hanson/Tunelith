<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tunelith.Maui.ViewModels"
             x:Class="Tunelith.Maui.Views.CategorizationPage"
             Style="{StaticResource PageStyle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,24,24,0">
            <VerticalStackLayout>
                <Label Text="Organize Library"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"/>
                <Label Text="AI-POWERED CATEGORIZATION"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       TextColor="{StaticResource TextSecondary}"
                       Margin="0,2,0,0"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Progress -->
        <VerticalStackLayout Grid.Row="1" Padding="24,16,24,0">
            <ProgressBar Progress="{Binding ProgressPercent, Converter={StaticResource PercentToDoubleConverter}}"
                         ProgressColor="{StaticResource PrimaryGold}"
                         HeightRequest="4"/>
            <Label Text="{Binding StatusMessage}"
                   Style="{StaticResource BodySecondaryLabel}"
                   FontSize="12"
                   Margin="0,8,0,0"/>
        </VerticalStackLayout>

        <!-- Categories & Duplicates -->
        <ScrollView Grid.Row="2" Padding="24,16,24,0">
            <VerticalStackLayout Spacing="12">

                <Label Text="CATEGORIES FOUND"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       TextColor="{StaticResource SecondaryCyan}"
                       IsVisible="{Binding Categories.Count, Converter={StaticResource IsGreaterThanZeroConverter}}"/>

                <CollectionView ItemsSource="{Binding Categories}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource GlassCard}" Padding="16,14" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"/>
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"/>
                                    </VerticalStackLayout>
                                    <Frame Grid.Column="1"
                                           Style="{StaticResource CategoryTag}"
                                           VerticalOptions="Center">
                                        <Label Text="{Binding TrackIds.Count, StringFormat='{0} tracks'}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource SecondaryCyan}"/>
                                    </Frame>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="DUPLICATES FOUND"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       TextColor="{StaticResource SecondaryCyan}"
                       Margin="0,8,0,0"
                       IsVisible="{Binding Duplicates.Count, Converter={StaticResource IsGreaterThanZeroConverter}}"/>

                <CollectionView ItemsSource="{Binding Duplicates}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource GlassCard}" Padding="16,14" Margin="0,0,0,8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Tracks[0].Name}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="{Binding Tracks[1].Name}"
                                           FontSize="14"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="{Binding Type, StringFormat='Type: {0}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom -->
        <VerticalStackLayout Grid.Row="3" Padding="24,12,24,24" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsProcessing}"
                               IsVisible="{Binding IsProcessing}"
                               Style="{StaticResource GoldActivityIndicator}"/>
            <Button Text="Run Categorization"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding RunCategorizationCommand}"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
